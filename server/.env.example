# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# MySQL 8 running locally as the MYSQL80 service.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/dayflow"

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# Email verification. Gmail requires an APP PASSWORD (Google Account →
# Security → 2-Step Verification → App passwords), never the login password.
# Strip the spaces Google shows: "abcd efgh ijkl mnop" -> "abcdefghijklmnop".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your16charapppassword
MAIL_FROM="Dayflow HRMS <you@gmail.com>"
OTP_TTL_MINUTES=10
